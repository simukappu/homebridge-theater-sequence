{
  "pluginAlias": "TheaterSequence",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Runs the theater start/stop sequence on this host and confirms each step. Publishes two buttons as Matter outlets (Alexa) and HomeKit switches (iPhone). Secrets live in owner-only files, not in config.json.",
  "schema": {
    "type": "object",
    "properties": {
      "name": { "title": "Name", "type": "string", "default": "Theater" },
      "startName": { "title": "Start Button Name", "type": "string", "default": "Theater Start", "maxLength": 32 },
      "stopName": { "title": "Stop Button Name", "type": "string", "default": "Theater Stop", "maxLength": 32 },
      "homekit": { "title": "Publish HomeKit Switches", "type": "boolean", "default": true },
      "projector": {
        "title": "Projector (Sony ADCP)", "type": "object",
        "properties": {
          "host": { "title": "IP Address", "type": "string", "format": "ipv4" },
          "port": { "title": "ADCP Port", "type": "integer", "default": 53595 },
          "passwordFile": { "title": "ADCP Password File", "type": "string", "placeholder": "~/.config/theater-sequence/adcp.json", "description": "JSON {\"password\": \"...\"}, chmod 600." }
        }
      },
      "screen": {
        "title": "Screen (SwitchBot IR, Others)", "type": "object",
        "properties": {
          "deviceId": { "title": "IR Remote deviceId", "type": "string" },
          "downButton": { "title": "Down Button Name", "type": "string" },
          "upButton": { "title": "Up Button Name", "type": "string" },
          "credentialsFile": { "title": "SwitchBot Credentials File", "type": "string", "placeholder": "~/.config/switchbot-ir/credentials.json" }
        }
      },
      "avr": {
        "title": "AVR (Denon HTTP, main zone)", "type": "object",
        "properties": {
          "host": { "title": "IP Address", "type": "string", "format": "ipv4" },
          "port": { "title": "HTTP Port", "type": "integer", "default": 8080 },
          "inputCode": { "title": "Input Code", "type": "string", "default": "BD" }
        }
      },
      "recorder": {
        "title": "Recorder (Sony BDZ over LAN)", "type": "object",
        "properties": {
          "host": { "title": "IP Address", "type": "string", "format": "ipv4" },
          "mac": { "title": "MAC Address (Wake-on-LAN)", "type": "string" },
          "broadcast": { "title": "Broadcast Address", "type": "string", "format": "ipv4" }
        }
      },
      "shutter": {
        "title": "Shutter (Somfy TaHoma / Connexoon, local API)", "type": "object",
        "properties": {
          "host": { "title": "Gateway IP Address", "type": "string", "format": "ipv4" },
          "pin": { "title": "Gateway PIN", "type": "string", "placeholder": "1234-5678-9012", "description": "Used as the TLS name gateway-<pin>.local the certificate is issued for." },
          "deviceURL": { "title": "Shutter deviceURL", "type": "string", "placeholder": "rts://1234-5678-9012/12345678", "description": "From GET /setup/devices." },
          "tokenFile": { "title": "Token File", "type": "string", "placeholder": "~/.config/theater-sequence/somfy.json", "description": "JSON {\"token\": \"...\"} from the TaHoma app's Developer Mode, chmod 600." },
          "caFile": { "title": "Overkiz Root CA File", "type": "string", "placeholder": "~/.config/theater-sequence/overkiz-root-ca-2048.crt", "description": "https://ca.overkiz.com/overkiz-root-ca-2048.crt — the gateway certificate is verified against it." }
        }
      }
    }
  }
}
